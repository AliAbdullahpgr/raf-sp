model MNSUAMEstateFacilities {
  id              String          @id @default(cuid())
  name            String
  type            String
  imageUrl        String?
  departmentId    String
  blockName       String?
  facilityType    String?
  capacityPersons Int?
  capacityLabel   String?
  displayOrder    Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  status          EquipmentStatus @default(AVAILABLE)
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([status])
}

model ValueAdditionLabEquipment {
  id           String          @id @default(cuid())
  name         String
  type         String
  imageUrl     String?
  departmentId String
  labName      String?
  roomNumber   String?
  blockName    String?
  quantity     Int             @default(1)
  focalPerson  String?
  displayOrder Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  status       EquipmentStatus @default(AVAILABLE)
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([status])
}

model CRIMultanAssets {
  id                String          @id @default(cuid())
  name              String
  type              String
  imageUrl          String?
  departmentId      String
  makeModel         String?
  labDepartment     String?
  purposeFunction   String?
  year              String?
  location          String?
