model RAEDCEquipment {
  id            String          @id @default(cuid())
  name          String
  type          String
  imageUrl      String?
  departmentId  String
  facilityType  String?
  capacity      Int?
  location      String?
  functionality String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  status        EquipmentStatus @default(AVAILABLE)
  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([status])
}

model AgriculturalExtensionWing {
  id              String          @id @default(cuid())
  name            String
  type            String
  location        String
  areaSquareFeet  Int?
  remarks         String?
  status          String
  functionality   String?
  departmentId    String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  equipmentStatus EquipmentStatus @default(AVAILABLE)
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([equipmentStatus])
}

model AdaptiveResearchPosition {
  id                      String     @id @default(cuid())
  attachedDepartment      String?
  postName                String
  bpsScale                String
  sanctionedPosts         Int
  filledPosts             Int
  vacantPosts             Int
  promotionPosts          Int
  initialRecruitmentPosts Int
  remarks                 String?
  orderNumber             Int?
  departmentId            String
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  department              Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([orderNumber])
}

model VisitorCounter {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  count     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model ento_inventory_items {
  id                      Int       @id @default(autoincrement())
  item_no                 Int
  name                    String
  quantity_label          String?
  date_received           DateTime? @db.Date
  last_verified           DateTime? @db.Date
  last_verification_label String?
  register_label          String?
  source_line             String?
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)

  @@index([date_received], map: "ento_inventory_date_received_idx")
  @@index([item_no], map: "ento_inventory_item_no_idx")
}

model ento_profile {
  id              Int       @id @default(autoincrement())
  department_id   String    @unique
  department_name String
  location        String?
  focal_person    String?
  designation     String?
  email           String?
  officers        Int?
  officials       Int?
  land_acres      Decimal?  @db.Decimal(10, 2)
  rooms           Int?
  register_title  String?
  register_note   String?
  compiled_on     DateTime? @db.Date
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
}

enum Role {
  ADMIN
  DEPT_HEAD
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  NEEDS_REPAIR
  DISCARDED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  BORROWED
  RETURNED
  OVERDUE
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_EXPIRING
  REQUEST_EXPIRED
  BORROW_STARTED
  RETURN_DUE_SOON
  RESOURCE_OVERDUE
  RESOURCE_RETURNED
}

// ==========================================
// RESOURCE REQUEST SYSTEM MODELS
// ==========================================

model ResourceRequest {
  id String @id @default(cuid())

  // Resource identification (polymorphic - works with any table)
  resourceType String // "Equipment" | "AMRIInventory" | "CRIMultanAssets" etc.
  resourceId   String // ID of the specific resource
  resourceName String // Cached name for display

  // Department relationships
  requestingDeptId String
  lendingDeptId    String
  requestingDept   Department @relation("RequestingDept", fields: [requestingDeptId], references: [id])
  lendingDept      Department @relation("LendingDept", fields: [lendingDeptId], references: [id])

  // Request metadata
  requestedById String
  requestedBy   User    @relation("RequestedBy", fields: [requestedById], references: [id])
  requestReason String?

  // Status tracking
  status RequestStatus @default(PENDING)

  // Approval workflow
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Borrowing details (set when approved)
  borrowDurationDays Int? // 10, 20, 30... 90
  borrowStartDate    DateTime?
  borrowEndDate      DateTime?
  actualReturnDate   DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // Auto-set to createdAt + 15 days

  // Relations
  auditLogs     RequestAuditLog[]
  notifications Notification[]

  @@index([requestingDeptId])
  @@index([lendingDeptId])
  @@index([requestedById])
  @@index([status])
  @@index([resourceType, resourceId])
  @@index([expiresAt])
}

model RequestAuditLog {
  id        String          @id @default(cuid())
  requestId String
  request   ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  action         String // "CREATED", "APPROVED", "REJECTED", "EXPIRED", "BORROWED", "RETURNED", "MARKED_OVERDUE"
  performedById  String
  performedBy    User          @relation(fields: [performedById], references: [id])
  previousStatus RequestStatus?
  newStatus      RequestStatus
  notes          String?
  metadata       Json? // Additional data like duration, dates, etc.

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([performedById])
  @@index([createdAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Optional link to request
  requestId String?
  request   ResourceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // Status
  read      Boolean @default(false)
  emailSent Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
